msgid "issued"
msgstr "已签发"

msgid "redeemed"
msgstr "已兑换"

msgid "revoked"
msgstr "已吊销"

msgid "active"
msgstr "有效"

msgid "suspended"
msgstr "已暂停"

msgid "bound"
msgstr "已绑定"

msgid "unbound"
msgstr "已解绑"

msgid "username must be 1-150 characters."
msgstr "用户名须为 1–150 个字符。"

msgid "password must not be empty."
msgstr "密码不能为空。"

msgid "This username is already taken."
msgstr "该用户名已被占用。"

msgid "Invalid username or password."
msgstr "用户名或密码不正确。"

msgid "max_devices must be an integer >= 1."
msgstr "max_devices 必须是大于等于 1 的整数。"

msgid "This license key is not recognized."
msgstr "无法识别此许可证密钥。"

msgid "This license key has been revoked."
msgstr "此许可证密钥已被吊销。"

msgid "This license key was already redeemed by another account."
msgstr "此许可证密钥已被其他账户兑换。"

msgid "This account already has an entitlement for this product."
msgstr "此账户已拥有该产品的授权。"

msgid "This entitlement is suspended."
msgstr "此授权已暂停。"

msgid "This entitlement has been revoked."
msgstr "此授权已被吊销。"

msgid "This entitlement has expired."
msgstr "此授权已过期。"

msgid "device_fingerprint must not be empty."
msgstr "device_fingerprint 不能为空。"

msgid "device_fingerprint exceeds 128 characters."
msgstr "device_fingerprint 不能超过 128 个字符。"

msgid "This entitlement has no remaining device seats."
msgstr "此授权已无剩余设备席位。"

msgid "No bound device matches this fingerprint."
msgstr "没有已绑定设备匹配此指纹。"

msgid "License Service"
msgstr "许可证服务"

